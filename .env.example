# Razorpay — server-only secrets (NEVER prefix these with NEXT_PUBLIC)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public Razorpay key id — safe to expose to the browser for the checkout widget
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# WhatsApp fallback (international format, digits only, e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase — server-only. The service role key bypasses RLS and must stay secret.
# When both are set, orders persist to Supabase; otherwise the local file store
# is used for development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only salt for hashing IPs in the review rate limiter (any long random string)
REVIEW_RATE_LIMIT_SALT=

# Delhivery shipping — server-only. Token/pickup from env (no login/password in code).
# If unset, payment still succeeds and the shipment is skipped (shipping_status stays pending).
DELHIVERY_API_TOKEN=
DELHIVERY_PICKUP_NAME=
DELHIVERY_BASE_URL=https://track.delhivery.com
